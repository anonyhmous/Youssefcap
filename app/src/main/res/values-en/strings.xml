    <!-- Commitments Screen -->
    <string name="commitments_title">DriveFlow Commitments</string>
    <string name="commitments_subtitle">What our application does and will NEVER do</string>
    <string name="commitments_item1_title">1. Never taps on your phone screen</string>
    <string name="commitments_item1_desc">There is no auto-click or gesture emulation code anywhere in this application.</string>
    <string name="commitments_item2_title">2. Never accepts or rejects rides automatically</string>
    <string name="commitments_item2_desc">The decision is 100% yours. DriveFlow provides colored insight; you press Accept or Decline.</string>
    <string name="commitments_item3_title">3. Never negotiates or bids automatically</string>
    <string name="commitments_item3_desc">DriveFlow only suggests a fair counter-offer; it never raises or lowers bids on your behalf.</string>
    <string name="commitments_item4_title">4. Never collects personal rider data</string>
    <string name="commitments_item4_desc">We never record rider names, phone numbers, or private identities.</string>
    <string name="commitments_item5_title">5. Never monitors apps outside driver apps</string>
    <string name="commitments_item5_desc">The reader is programmed to inspect content exclusively when inDrive, Uber, or DiDi are open.</string>

