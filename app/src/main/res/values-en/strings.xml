    <!-- Install Guide Screen -->
    <string name="guide_title">Permissions Setup Guide (Android 13+)</string>
    <string name="guide_step1_title">Step 1: Allow Restricted Settings</string>
    <string name="guide_step1_desc">Because this app is sideloaded: Go to App Info > tap the three dots in top bar > select Allow restricted settings and confirm with phone lock.</string>
    <string name="guide_step2_title">Step 2: Enable Accessibility Service</string>
    <string name="guide_step2_desc">Go to Phone Settings > Accessibility > Installed Apps > DriveFlow Driver > Turn ON.</string>
    <string name="guide_step3_title">Step 3: Allow Display Over Other Apps</string>
    <string name="guide_step3_desc">Grant permission to show floating verdicts over other ride apps.</string>
    <string name="guide_step4_title">Step 4: Disable Battery Optimization</string>
    <string name="guide_step4_desc">Set battery usage to Unrestricted and enable Autostart (Xiaomi/Oppo) to prevent the OS from killing the reader.</string>
