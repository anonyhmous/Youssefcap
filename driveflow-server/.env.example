# DriveFlow Server Configuration

PORT=3000
DATA_DIR=./data
PUBLIC_BASE_URL=http://localhost:3000

# Security & Signing (Generate using: npm run gen-keys)
SERVER_SIGNING_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Admin Credentials
ADMIN_USERNAME=admin
# bcrypt hash of admin password
ADMIN_PASSWORD_HASH=$2a$10$wT2m7hGz94P6n8qGk/eDMe.zE7mR7w2x2g0p8Z3p4l5k6j7h8i9j0
JWT_SECRET=replace_with_a_secure_jwt_secret_at_least_32_chars_long
